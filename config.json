{
    "stratumPort": 8000,
    "stratumSSL": {
        "enabled": false,
        "key" : "key.pem",
        "cert" : "cert.pem"
    },
    "pools": [
        { "name": "luckpool NA", "host": "na.luckpool.net", "port": 3958, "ssl": true },
        { "name": "verus.io", "host": "pool.verus.io", "port": 9998, "ssl": false }
    ],

    "failover": {
        "enabled": true,
        "connectFailures": 2,
        "connectTimeoutSec": 15,
        "submitTimeoutSec": 60,
        "probeEverySec": 60,
        "failback": true,
        "failbackAfterSec": 300
    },
    "wallet": false,
    "password": false,

    "dashboard": {
        "enabled": true,
        "host": "0.0.0.0",
        "port": 8080,
        "auth": "",
        "reportToken": "",
        "hashrateWindowSec": 600,
        "staleAfterSec": 300,
        "forgetOfflineAfterDays": 14,
        "dataDir": "data",
        "ccminerApi": true,
        "ccminerApiPort": 4068,
        "ccminerPollSec": 30,
        "ccminerHosts": []
    }
}
