{
    "stratumPort": 8000,
    "stratumSSL": {
        "enabled": false,
        "key" : "key.pem",
        "cert" : "cert.pem"
    },
    "pools": [
        { "name": "luckpool NA", "host": "na.luckpool.net", "port": 3958, "ssl": true },
        { "name": "verus.io", "host": "pool.verus.io", "port": 9998, "ssl": false }
    ],

    "failover": {
        "enabled": true,
        "connectFailures": 2,
        "connectTimeoutSec": 15,
        "submitTimeoutSec": 60,
        "probeEverySec": 60,
        "failback": true,
        "failbackAfterSec": 300
    },
    "minerKeepaliveSec": 30,
    "wallet": false,
    "password": false,

    "ssh": {
        "enabled": false,
        "user": "eek",
        "port": 8022,
        "identityFile": "",
        "timeoutSec": 60,
        "parallel": 10,
        "allowCustomCommands": true,
        "presets": [
            { "name": "Uptime", "command": "uptime" },
            { "name": "ccminer running?", "command": "pgrep -af ccminer || echo 'ccminer is NOT running'" },
            { "name": "Battery", "command": "termux-battery-status 2>/dev/null || cat /sys/class/power_supply/battery/capacity 2>/dev/null || echo 'no battery info'" },
            { "name": "Disk & memory", "command": "df -h $HOME | tail -n 1; free -m 2>/dev/null | head -n 2" },
            { "name": "Stop ccminer", "command": "pkill -f ccminer && echo stopped || echo 'was not running'" }
        ]
    },

    "dashboard": {
        "enabled": true,
        "host": "0.0.0.0",
        "port": 8080,
        "auth": "",
        "reportToken": "",
        "hashrateWindowSec": 600,
        "staleAfterSec": 300,
        "forgetOfflineAfterDays": 14,
        "dataDir": "data",
        "ccminerApi": true,
        "ccminerApiPort": 4068,
        "ccminerPollSec": 30,
        "ccminerHosts": []
    }
}
