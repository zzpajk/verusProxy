# /etc/systemd/system/verusproxy-watchdog.service
# Restarts verusProxy if it is running but stalled (health check fails twice, 20 s apart).
# Edit the path if verusProxy isn't in /home/pi/verusProxy.
[Unit]
Description=Restart verusProxy if stalled

[Service]
Type=oneshot
WorkingDirectory=/home/pi/verusProxy
ExecStart=/bin/sh -c 'node deploy/healthcheck.js || { sleep 20; node deploy/healthcheck.js; } || { echo "verusProxy stalled, restarting"; systemctl restart verusproxy; }'
